# Optional environment overrides for IDEA Run Configuration. Spring does not read this file automatically.
# Local configuration is in backend/src/main/resources/application-local.yml.
DB_URL=jdbc:mysql://127.0.0.1:3306/hospital?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USER=root
DB_PASSWORD=replace-with-local-database-password
SEED_DEMO=true
DEMO_PASSWORD=Demo12345!
QUEUE_ENABLED=false
QUARTZ_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
